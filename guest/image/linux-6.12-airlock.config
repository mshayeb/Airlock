# Hardened minimal Linux 6.12 LTS guest kernel configuration for Airlock Phase 1
# (`spec.md` §4 & §9.1 SEC-2; FR-NET-1 zero virtio-net)

# Target Architectures: arm64 (Apple Silicon VZ & Graviton) / x86_64 (Firecracker)
CONFIG_64BIT=y
CONFIG_LOCALVERSION="-airlock-p1"

# Essential VirtIO transports (vsock, blk, fs, console, entropy)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Guest-side filesystems (`Scrubbed Base` RO + `CoW Upper` RW + overlayfs)
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y

# Local loopback & tun0 packet capture (zero physical/virtual Ethernet NIC)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TUN=y
# CONFIG_VIRTIO_NET is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_WLAN is not set

# Containers-in-guest support (user/pid/net/mount namespaces, cgroups v2)
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y

# Attack-surface reduction (`SEC-2`)
# CONFIG_MODULES is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVKMEM is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_KALLSYMS is not set
CONFIG_BPF_JIT=y
CONFIG_SECURITY_LANDLOCK=y
